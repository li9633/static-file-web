# 自动检测文本/二进制
* text=auto

# 源代码（强制 LF）
*.ts        text eol=lf
*.vue       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.env       text eol=lf

# Shell 脚本
*.sh        text eol=lf

# 锁文件
package-lock.json text eol=lf
pnpm-lock.yaml    text eol=lf

# 二进制文件
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary