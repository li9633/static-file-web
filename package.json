{
  "name": "static-file-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run gen:index && vite",
    "gen:index": "node scripts/generate-files-index.mjs",
    "copy:files": "node scripts/copy-files.mjs",
    "build": "npm run gen:index && vue-tsc --noEmit && vite build && npm run copy:files",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "element-plus": "^2.14.5",
    "sass": "^1.103.1",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true,
    "@parcel/watcher@2.6.0": true
  }
}
